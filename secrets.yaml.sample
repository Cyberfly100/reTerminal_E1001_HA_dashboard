# Copy to secrets.yaml and fill in your own values
# (secrets.yaml is never committed; this sample carries
# throwaway but format-valid values so CI can build
# with it directly)
#
# The API encryption key must decode to 32 bytes —
# and must not be the all-zeros value (ESPHome
# 2026.10+ rejects it):
#   openssl rand -base64 32

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

reterminal_e1001_entrance__encryption_key: "CTKuSp6j8hjUUUR2mdQVcEypHmFOzHvjOsoyDC9mt3Q="
reterminal_e1001_entrance__ap_password: "fallback-ap-password"
